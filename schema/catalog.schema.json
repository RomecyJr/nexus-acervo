{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-acervo.local/schema/catalog.schema.json",
  "title": "Nexus Acervo Catalog",
  "type": "object",
  "required": ["meta", "segments", "items"],
  "properties": {
    "meta": {"type":"object","required":["name","version","generatedAt","language"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"generatedAt":{"type":"string","format":"date-time"},"language":{"type":"string"},"sourceFile":{"type":"string"}},"additionalProperties":true},
    "segments": {"type":"array","items":{"type":"object","required":["id","label"],"properties":{"id":{"type":"string"},"label":{"type":"string"}},"additionalProperties":false}},
    "items": {"type":"array","items":{"$ref":"#/$defs/item"}}
  },
  "$defs": {"item":{"type":"object","required":["id","title","kind","segment","url","description","tags","status","year","source","addedAt","updatedAt"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"title":{"type":"string","minLength":2},"kind":{"enum":["ferramenta","vídeo","repositório","conhecimento","diretório"]},"segment":{"type":"string"},"url":{"type":"string","format":"uri"},"description":{"type":"string"},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},"status":{"type":"string"},"year":{"type":"integer","minimum":1900},"source":{"type":"string"},"addedAt":{"type":"string","format":"date"},"updatedAt":{"type":"string","format":"date"},"license":{"type":"string"},"openAccess":{"type":"boolean"},"notes":{"type":"string"},"deliverable":{"type":"string"},"youtubeId":{"type":"string"},"thumbnail":{"type":"string"},"targetAudience":{"type":"string"}},"additionalProperties":false}}
}
